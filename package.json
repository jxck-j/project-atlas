{
  "name": "project-atlas",
  "private": true,
  "version": "6.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:geo": "npm run build:geo:countries && npm run build:geo:entities && npm run build:geo:states && npm run build:geo:cities && npm run build:geo:lakes && npm run build:geo:rivers",
    "build:geo:countries": "node scripts/buildCountryTopology.mjs",
    "build:geo:entities": "node scripts/buildEntityTopology.mjs",
    "build:geo:states": "node scripts/buildStatesProvincesTopology.mjs",
    "build:geo:cities": "node scripts/buildCitiesData.mjs",
    "build:geo:lakes": "node scripts/buildLakesTopology.mjs",
    "build:geo:rivers": "node scripts/buildRiversTopology.mjs",
    "build:geo:us-cities": "node scripts/buildUsCitiesData.mjs",
    "build:profiles": "tsx scripts/buildGovCapitalPopGdp.mjs",
    "build:military": "node scripts/buildMilitary.mjs",
    "build:economy": "node scripts/buildEconomy.mjs",
    "build:economy-weo-trial": "tsx scripts/buildEconomyWeo.mjs",
    "build:geo-entity-economics": "tsx scripts/buildGeoEntityEconomics.mjs",
    "docs:claims": "tsx scripts/generateClaimsDoc.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "earcut": "^3.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/earcut": "^3.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.19",
    "shapefile": "^0.6.6",
    "tailwindcss": "^4.3.3",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "xlsx": "^0.18.5"
  }
