.idea

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local Claude Code settings (machine-specific paths/permissions)
.claude/settings.local.json

# one-off build-script diagnostic output (e.g. scripts/buildEconomy.mjs's
# debug/economy-component-breakdown.json) — regenerable, not consumed by
# the app, not meant to be a permanent repo artifact
debug/

# append-only news article archive (scripts/lib/newsArchive.mjs). Unlike debug/
# it is NOT regenerable — an RSS window that rolled off can't be re-fetched — so
# it's ignored only because it's data, not source. It exists on this machine only.
archive/

# the per-tab first-hand ticker (scripts/buildFirstHandTicker.mjs): raw third-party channel text, rebuilt hourly. Publishing it is the same open
# question as news-events.json (BACKLOG.md) and it should not accumulate in history in the meantime.
public/data/news-firsthand.json
public/data/news-firsthand.json.tmp
